# Скопируй в .env и заполни. Файл .env в репозиторий не попадает (.gitignore).
# Приложение падает на старте, если не хватает обязательной переменной.

# --- Обязательные ---------------------------------------------------------

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Секрет вебхука. Придумывается один раз и живёт в переменных окружения.
# Допустимы только A-Z, a-z, 0-9 и дефис; минимум 16 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(24))"
TELEGRAM_WEBHOOK_SECRET=

# Публичный адрес сервиса, только https. На Railway — домен сервиса.
# Из него собирается адрес вебхука, который регистрируется при старте.
PUBLIC_URL=https://your-service.up.railway.app

# PostgreSQL. На Railway появляется сам, когда добавишь плагин базы.
# Обязательна: без базы лимиты и бонусы не переживают даже перезапуск.
DATABASE_URL=

# Ключ провайдера ИИ. Один и тот же используется для текста и картинок,
# если не задан отдельный IMAGE_API_KEY.
LLM_API_KEY=

# --- База данных ----------------------------------------------------------

# Накатывать миграции при старте. Сервис однопроцессный, гонки быть не может.
RUN_MIGRATIONS_ON_START=true

# --- MAX ------------------------------------------------------------------

# Токен бота MAX от @MasterBot. Пустой — сервис работает только с Telegram.
# Публиковать ботов в MAX могут только верифицированные российские юрлица.
MAX_BOT_TOKEN=

# Секрет вебхука MAX. Пустой — берётся TELEGRAM_WEBHOOK_SECRET: алфавит у них
# общий, и второй секрет заводить незачем.
MAX_WEBHOOK_SECRET=

# Таймаут вызовов к MAX. Больше телеграмного: отправка картинки там
# двухшаговая, с загрузкой файла и паузой на готовность вложения.
MAX_API_TIMEOUT_SECONDS=30

# --- Провайдеры ИИ --------------------------------------------------------

# Адрес OpenAI-совместимого API. Подходит любой шлюз с тем же форматом
# /chat/completions и /images/generations.
LLM_BASE_URL=https://api.openai.com/v1

# Модели по классам тарифа. Пользователю не показываются.
MODEL_ECONOMY=gpt-5-mini
MODEL_STANDARD=gpt-5

# Потолок длины ответа и таймаут вызова.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Сколько реплик диалога уходит в каждый запрос. Главный рычаг стоимости
# после выбора модели: контекст отправляется заново с каждым сообщением.
DIALOG_MAX_TURNS=10

# Инструкция модели. Пустое значение — берётся из config/prompt.py.
# LLM_SYSTEM_PROMPT=

# Ограничения на провайдера текста.
LLM_RATE_PER_SECOND=20
LLM_BURST=40
LLM_CONCURRENCY=16

# Картинки. Ключ пустой — берётся LLM_API_KEY.
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024

# Картинка рисуется десятки секунд — таймаут заметно больше текстового.
IMAGE_TIMEOUT_SECONDS=180

IMAGE_RATE_PER_SECOND=5
IMAGE_BURST=10
IMAGE_CONCURRENCY=8

# Повторов у картинок меньше: каждая попытка стоит денег.
IMAGE_RETRY_ATTEMPTS=2

# --- Оплата ---------------------------------------------------------------

# ЮKassa: магазин и секретный ключ из личного кабинета. Пустые — оплата
# картой выключена, платить можно только звёздами Telegram.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Адрес API. Меняется на тестовый магазин при отладке.
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=20

# Куда вернуть человека после оплаты. Пустой — вернём в переписку с ботом.
YOOKASSA_RETURN_URL=

# Наценка на оплату звёздами: Telegram берёт комиссию, §2.8 требует +40%.
STARS_MARKUP=1.4

# Сколько рублей стоит одна звезда. Величина внешняя, курс задаёт Telegram.
RUB_PER_STAR=1.6

# На сколько дней выдаётся подписка после оплаты.
SUBSCRIPTION_DAYS=30

# Умеет ли магазин ЮKassa автоплатежи — списания по сохранённой карте.
# Возможность подключается в кабинете отдельно и не всякому магазину. Пока
# false, оплата картой остаётся разовой: продления не будет, и на экране
# заказа так и написано. Подписка на звёздах Telegram от этого не зависит —
# там списывает сам мессенджер.
YOOKASSA_RECURRING=false

# Как часто планировщик проверяет, кому пора списать и кого предупредить.
# Раз в час: реже — рискуем опоздать с суточным предупреждением (§4.13
# оферты), чаще — незачем, все сроки здесь измеряются днями.
BILLING_INTERVAL_SECONDS=3600

# Сколько подписок разбирать за один проход. Остаток дождётся следующего.
BILLING_BATCH=100

# Оферта и политика обработки данных. Пока не заданы, оплата в боте не
# показывается вовсе: брать деньги, не показав условия, нельзя.
OFFER_URL=
PRIVACY_URL=

# Редакция документов, например 2026-08-31. Пишется в каждый заказ и в лог
# согласия — по ней потом видно, с чем именно человек согласился.
DOCS_VERSION=

# --- Продуктовые ограничения ----------------------------------------------

# Потолок размера присланного фото в байтах. Больше — отказ без запроса
# к провайдеру.
MAX_PHOTO_BYTES=5242880

# Сколько одновременных задач разрешено одному человеку на вид работы.
FLOOD_LIMIT_PER_USER=1

# --- Необязательные -------------------------------------------------------

# Порт HTTP-сервера. На Railway подставляется автоматически, локально 8080.
PORT=8080

# local включает читаемые логи вместо JSON.
APP_ENV=production

LOG_LEVEL=INFO

# Сколько секунд дать текущим задачам доработать после SIGTERM.
# Должно быть заведомо меньше RAILWAY_DEPLOYMENT_DRAINING_SECONDS.
SHUTDOWN_TIMEOUT_SECONDS=20

# Сколько обновлений помещается в очередь. За этим пределом мессенджер
# получает отказ и повторит доставку позже.
QUEUE_CAPACITY=1000

# Сколько обновлений обрабатывается одновременно.
QUEUE_WORKERS=16

# Сколько помним ключ обновления, чтобы не обработать повтор дважды.
DEDUP_TTL_SECONDS=600

# Потолок числа запомненных ключей — защита от роста памяти.
DEDUP_MAX_KEYS=100000
