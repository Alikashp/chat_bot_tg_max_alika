# Скопируй в .env и заполни. Файл .env в репозиторий не попадает (.gitignore).
# Приложение падает на старте, если не хватает обязательной переменной.

# --- Обязательные ---------------------------------------------------------

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Секрет вебхука. Придумывается один раз и живёт в переменных окружения.
# Допустимы только A-Z, a-z, 0-9 и дефис; минимум 16 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(24))"
TELEGRAM_WEBHOOK_SECRET=

# Публичный адрес сервиса, только https. На Railway — домен сервиса.
# Из него собирается адрес вебхука, который регистрируется при старте.
PUBLIC_URL=https://your-service.up.railway.app

# --- База данных ----------------------------------------------------------

# PostgreSQL. На Railway появляется сам, когда добавишь плагин базы.
# Пока необязательна: продуктовые сценарии подключаются к боту на фазе 4.
# С фазы 4 станет обязательной — подписки и лимиты обязаны переживать выкатку.
DATABASE_URL=

# Накатывать миграции при старте. Сервис однопроцессный, гонки быть не может.
RUN_MIGRATIONS_ON_START=true

# --- Необязательные -------------------------------------------------------

# Порт HTTP-сервера. На Railway подставляется автоматически, локально 8080.
PORT=8080

# local включает читаемые логи вместо JSON.
APP_ENV=production

LOG_LEVEL=INFO

# Сколько секунд дать текущим задачам доработать после SIGTERM.
# Должно быть заведомо меньше RAILWAY_DEPLOYMENT_DRAINING_SECONDS.
SHUTDOWN_TIMEOUT_SECONDS=20

# Сколько обновлений помещается в очередь. За этим пределом мессенджер
# получает отказ и повторит доставку позже.
QUEUE_CAPACITY=1000

# Сколько обновлений обрабатывается одновременно.
QUEUE_WORKERS=16

# Сколько помним ключ обновления, чтобы не обработать повтор дважды.
DEDUP_TTL_SECONDS=600

# Потолок числа запомненных ключей — защита от роста памяти.
DEDUP_MAX_KEYS=100000
